
const CONFIG = {
  trackerSheet: "summer 2027",
  reviewSheet: "Missing Applications",
  startDate: "2026/06/01"
};

function normalizeCompany(name) {
  return String(name || "")
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/\b(inc|llc|ltd|corporation|corp)\b/g, "")
    .replace(/[^a-z0-9]/g, "");
}

function findMissingApplications() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tracker = ss.getSheetByName(CONFIG.trackerSheet);
  if (!tracker) throw new Error("Tracker sheet not found");

  let review = ss.getSheetByName(CONFIG.reviewSheet);
  if (!review) {
    review = ss.insertSheet(CONFIG.reviewSheet);
    review.appendRow([
      "Company (Suggested)", "Email Subject",
      "Email Date", "Sender", "Gmail Link",
      "Review Status"
    ]);
    review.setFrozenRows(1);
  }

  const existing = new Set();

  function addNames(sheet, column, startRow) {
    const count = sheet.getLastRow() - startRow + 1;
    if (count <= 0) return;
    sheet.getRange(startRow, column, count, 1)
      .getValues().flat()
      .forEach(v => {
        if (v) existing.add(normalizeCompany(v));
      });
  }

  addNames(tracker, 1, 14);
  addNames(review, 1, 2);

  const query = `after:${CONFIG.startDate} ` +
    '{"thank you for applying" "thanks for applying" ' +
    '"application received" "application confirmation" ' +
    '"we received your application" "your application to" ' +
    '"application has been submitted"}';

  const messages = [];
  for (let offset = 0; ; offset += 100) {
    const threads = GmailApp.search(query, offset, 100);
    if (!threads.length) break;
    threads.forEach(t => messages.push(...t.getMessages()));
    if (threads.length < 100) break;
  }

  const rows = [];

  for (const msg of messages) {
    const subject = msg.getSubject();
    const sender = msg.getFrom();
    const body = msg.getPlainBody().slice(0, 2500);

    // Common confirmation email patterns
    const patterns = [
      /thank you for applying to\s+([^\n.!]+)/i,
      /thanks for applying to\s+([^\n.!]+)/i,
      /your application to\s+([^\n.!]+)/i,
      /interest in (?:joining|working at)\s+([^\n.!]+)/i
    ];

    let company = "";

    for (const pattern of patterns) {
      const match = body.match(pattern) || subject.match(pattern);
      if (match) {
        company = match[1].trim();
        break;
      }
    }

    // Fallback: sender's display name
    if (!company) {
      const match = sender.match(/^"?([^"<]+)"?\s*</);
      if (match) company = match[1].trim();
    }

    if (!company) continue;

    const key = normalizeCompany(company);
    if (!key || existing.has(key)) continue;

    existing.add(key);
    rows.push([
      company,
      subject,
      msg.getDate(),
      sender,
      `https://mail.google.com/mail/u/0/#all/${msg.getId()}`,
      "Needs Review"
    ]);
  }

  if (rows.length) {
    review.getRange(
      review.getLastRow() + 1, 1, rows.length, 6
    ).setValues(rows);
  }

  Logger.log(`Found ${rows.length} possible missing applications`);
}
